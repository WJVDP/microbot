#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 || ! "$1" =~ ^[A-Z][A-Za-z0-9]*$ ]]; then
  echo "Usage: $0 PluginName" >&2
  echo "PluginName must be PascalCase, for example: Woodcutter" >&2
  exit 2
fi

plugin_name="$1"
package_suffix="plan$(printf '%s' "$plugin_name" | tr '[:upper:]' '[:lower:]')"
plugin_slug="$(printf '%s' "$plugin_name" | sed -E 's/([A-Z]+)([A-Z][a-z])|([a-z0-9])([A-Z])/\1\3-\2\4/g' | tr '[:upper:]' '[:lower:]')"
control_center_id="plan-$plugin_slug"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
template_dir="$repo_root/scripts/plan-plugin-template"
target_dir="$repo_root/microbot-plugins/src/main/java/net/runelite/client/plugins/microbot/$package_suffix"

if [[ -e "$target_dir" ]]; then
  echo "Target already exists: $target_dir" >&2
  exit 1
fi

mkdir -p "$target_dir"
for template in "$template_dir"/*.java.template; do
  output_name="$(basename "$template" .java.template)"
  output_name="${output_name//PluginName/$plugin_name}.java"
  sed \
    -e "s/__PLUGIN_NAME__/$plugin_name/g" \
    -e "s/__PACKAGE_SUFFIX__/$package_suffix/g" \
    -e "s/__CONTROL_CENTER_ID__/$control_center_id/g" \
    "$template" > "$target_dir/$output_name"
done

echo "Created $target_dir"
echo "Next: edit requirements/actions, then run ./gradlew :client:compileJava"
