#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_DIR=$(dirname "$SCRIPT_DIR")
PROTOTYPE_DIR="$REPO_DIR/runelite-client/src/main/resources/net/runelite/client/plugins/microbot/agentserver/dashboard-prototype"

echo "Control Center prototype: http://0.0.0.0:4173/?variant=A"
exec python3 -m http.server 4173 --bind 0.0.0.0 --directory "$PROTOTYPE_DIR"
